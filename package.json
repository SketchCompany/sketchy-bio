{
  "name": "sketchy-bio",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.mts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:pi": "prisma generate && next build && node scripts/copy-standalone.mjs",
    "start": "next start",
    "start:prod": "node .next/standalone/server.js",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=.env prisma/seed.mts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grid-layout": "^1.5.3",
    "react-markdown": "^10.1.0",
    "react-resizable": "^4.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
