# Nginx reverse proxy for sketchy.sketch-company.de
# Copy to /etc/nginx/sites-available/sketchy, symlink into sites-enabled, test, reload:
#   sudo ln -s /etc/nginx/sites-available/sketchy /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Then add HTTPS with certbot:  sudo certbot --nginx -d sketchy.sketch-company.de

server {
    listen 80;
    server_name sketchy.sketch-company.de;

    # Uploaded media, served straight from disk (matches UPLOAD_DIR in .env).
    # Create it once:  sudo mkdir -p /var/www/sketchy/uploads && sudo chown pi:pi /var/www/sketchy/uploads
    location /uploads/ {
        alias /var/www/sketchy/uploads/;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Next.js static assets — long cache.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 60m;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    client_max_body_size 30M; # keep in sync with NEXT_PUBLIC_MAX_UPLOAD_MB
}
